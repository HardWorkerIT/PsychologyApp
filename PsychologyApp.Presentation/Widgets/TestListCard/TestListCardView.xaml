<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.TestListCard"
             x:Class="PsychologyApp.Presentation.Widgets.TestListCard.TestListCardView">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="self:TestListCardView">
            <Border Style="{StaticResource TestListCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource IconTileStyle}"
                        BackgroundColor="{TemplateBinding TileColor}"
                        VerticalOptions="Start">
                        <ui:MaterialIconView
                            IconName="{TemplateBinding IconName}"
                            IconSize="22"
                            IconColor="{TemplateBinding IconTint}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label
                            Text="{TemplateBinding Title}"
                            Style="{StaticResource ListRowTitleStyle}"
                            MaxLines="3"
                            LineBreakMode="WordWrap" />
                        <Label
                            Text="{TemplateBinding Subtitle}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Label
                            IsVisible="{TemplateBinding HasMetaText}"
                            Text="{TemplateBinding MetaText}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <VerticalStackLayout Spacing="8" IsVisible="{TemplateBinding HasLastResult}">
                            <Label
                                Text="{TemplateBinding LastResultText}"
                                Style="{StaticResource CaptionStyle}"
                                FontFamily="{StaticResource MediumFontFamily}"
                                MinimumHeightRequest="44"
                                VerticalTextAlignment="Center"
                                MaxLines="2"
                                LineBreakMode="WordWrap">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding OpenHistoryCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <FlexLayout
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Start"
                                JustifyContent="Start">
                                <Border
                                    Style="{StaticResource MetaPillStyle}"
                                    Padding="14,8"
                                    FlexLayout.Shrink="0"
                                    Margin="0,0,8,4"
                                    MinimumHeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding RetakeCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{TemplateBinding RetakeLabel}"
                                        Style="{StaticResource CaptionStyle}"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                                </Border>
                                <Border
                                    IsVisible="{TemplateBinding HasMultipleResults}"
                                    Style="{StaticResource MetaPillStyle}"
                                    Padding="14,8"
                                    FlexLayout.Shrink="0"
                                    Margin="0,0,8,4"
                                    MinimumHeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding OpenHistoryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{TemplateBinding HistoryLabel}"
                                        Style="{StaticResource CaptionStyle}"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        Text="{mi:Material Icon=KeyboardArrowRight}" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
