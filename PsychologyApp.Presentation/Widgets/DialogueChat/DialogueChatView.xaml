<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Widgets.DialogueChat.DialogueChatView"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:tension="clr-namespace:PsychologyApp.Presentation.Widgets.TensionSlider"
             xmlns:chat="clr-namespace:PsychologyApp.Presentation.Widgets.DialogueChat"
             x:DataType="chat:ChatViewModelBase">

    <ContentView.Resources>
        <DataTemplate x:Key="SuggestionChipTemplate" x:DataType="chat:DialogueSuggestionItem">
                            <Border MaximumWidthRequest="240" Style="{StaticResource DialogueAnswerChipStyle}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" Style="{StaticResource AnswerChipLabelStyle}" MaxLines="2" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
    </ContentView.Resources>

    <!-- Same look as the main chat: the same bubbles, the same typing dots, the same bar at the bottom, the same tension slider. -->
    <Grid RowDefinitions="*,Auto">

        <CollectionView
            x:Name="MessageList"
            Grid.Row="0"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chat:DialogueMessage">
                    <Border
                        HorizontalOptions="{Binding Alignment}"
                        MaximumWidthRequest="300"
                        Padding="14,10"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18,18,4,18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,4" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ui:TypingBubbleView IsVisible="{Binding IsTyping}" IsRunning="{Binding IsTyping}" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="0">

            <!-- Typical answers and, for a feeling, the emotion palette: tapped into the draft instead of typed. -->
            <ui:EmotionPickerView
                IsVisible="{Binding ShowEmotionPicker}"
                Margin="0,10,0,0"
                Text="{Binding DraftText, Mode=TwoWay}" />
            <!-- Quick answers stay in one horizontally scrollable row, preserving room for the conversation and keyboard. -->
            <ScrollView
                IsVisible="{Binding ShowSuggestions}"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Margin="0,8,0,0">
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding Suggestions}"
                    BindableLayout.ItemTemplate="{StaticResource SuggestionChipTemplate}" />
            </ScrollView>

            <!-- Match the main chat: collapse optional answers while the keyboard is open; tap to reveal them again. -->
            <Border
                IsVisible="{Binding ShowReplyOptionsToggle}"
                Margin="0,4,0,0"
                Padding="12,5"
                MinimumHeightRequest="44"
                HorizontalOptions="Start"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                SemanticProperties.Description="{Binding ReplyOptionsText}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReplyOptionsTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{Binding ReplyOptionsText}"
                    FontSize="13"
                    FontFamily="{StaticResource MediumFontFamily}"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    VerticalOptions="Center" />
            </Border>

            <!-- Free text answer -->
            <ui:ChatInputBar
                x:Name="InputBar"
                IsVisible="{Binding IsTextInput}"
                Margin="0,8,0,0"
                Text="{Binding DraftText, Mode=TwoWay}"
                Placeholder="{Binding InputPlaceholder}"
                SendCommand="{Binding SendCommand}"
                CanSend="{Binding CanSend}"
                SendDescription="{Binding SendText}"
                MaxLength="1000" />

            <!-- Choice chips -->
            <FlexLayout
                IsVisible="{Binding IsChoiceInput}"
                Wrap="Wrap"
                JustifyContent="Start"
                Margin="0,10,0,0"
                BindableLayout.ItemsSource="{Binding Choices}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="chat:DialogueChoiceItem">
                        <Border
                            Margin="0,0,8,8"
                            FlexLayout.Shrink="0"
                            Padding="14,8"
                            MinimumHeightRequest="44"
                            StrokeThickness="1.2"
                            Stroke="{DynamicResource Primary}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Index}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{Binding Label}"
                                FontSize="14"
                                FontFamily="{StaticResource MediumFontFamily}"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- 0..10 tension: one slider, like in the main chat -->
            <Border
                IsVisible="{Binding IsRatingInput}"
                Margin="0,8,0,0"
                Padding="0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <tension:TensionSliderView x:Name="TensionPicker" Chosen="OnTensionChosen" />
            </Border>

            <!-- End of conversation -->
            <ui:ButtonView
                IsVisible="{Binding IsFinished}"
                Margin="0,8,0,0"
                BodyText="{Binding FinishText}"
                TapCommand="{Binding FinishCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
