<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testUi="clr-namespace:PsychologyApp.Presentation.Widgets.Test"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.Test"
             x:DataType="self:TestHistoryEntryView"
             x:Class="PsychologyApp.Presentation.Widgets.Test.TestHistoryEntryView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:ListItemRevealBehavior />
    </ContentView.Behaviors>

    <Border Style="{StaticResource ListEntryCardStyle}">
        <VerticalStackLayout Spacing="6">
            <!-- The result first, in the row title's weight, the date under it: the date on top made every card look the same. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding SummaryText, Source={x:Reference Root}}" Style="{StaticResource ListRowTitleStyle}" />
                    <Label Text="{Binding DateText, Source={x:Reference Root}}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
                <Border
                    Grid.Column="1"
                    VerticalOptions="Start"
                    IsVisible="{Binding HasTrend, Source={x:Reference Root}}"
                    Padding="8,2"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}">
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding IsWorse, Source={x:Reference Root}}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Label
                        Text="{Binding TrendText, Source={x:Reference Root}}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        FontFamily="{StaticResource SemiBoldFontFamily}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsWorse, Source={x:Reference Root}}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>
            <Label
                IsVisible="{Binding HasScore, Source={x:Reference Root}}"
                Text="{Binding ScoreText, Source={x:Reference Root}}"
                Style="{StaticResource CaptionStyle}"
                FontFamily="{StaticResource MediumFontFamily}"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />

            <VerticalStackLayout IsVisible="{Binding HasDetail, Source={x:Reference Root}}" Spacing="4">
                <Grid
                    ColumnDefinitions="*,Auto"
                    MinimumHeightRequest="44"
                    Padding="4,0"
                    SemanticProperties.Description="{Binding DurationText, Source={x:Reference Root}}"
                    SemanticProperties.Hint="{Binding DetailToggleHint, Source={x:Reference Root}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDetailCommand, Source={x:Reference Root}}" />
                    </Grid.GestureRecognizers>
                    <Label
                        Text="{Binding DurationText, Source={x:Reference Root}}"
                        Style="{StaticResource CaptionStyle}"
                        VerticalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="0">
                        <ui:MaterialIconView
                            IconName="ExpandMore"
                            IconSize="20"
                            IconColor="{AppThemeBinding Light={DynamicResource TextSecondaryLight}, Dark={DynamicResource TextSecondaryDark}}"
                            AutomationProperties.IsInAccessibleTree="False"
                            VerticalOptions="Center">
                            <ui:MaterialIconView.Triggers>
                                <DataTrigger Binding="{Binding IsDetailExpanded, Source={x:Reference Root}}" TargetType="ui:MaterialIconView" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ui:MaterialIconView.Triggers>
                        </ui:MaterialIconView>
                        <ui:MaterialIconView
                            Grid.Column="1"
                            IconName="ExpandLess"
                            IconSize="20"
                            IconColor="{AppThemeBinding Light={DynamicResource TextSecondaryLight}, Dark={DynamicResource TextSecondaryDark}}"
                            AutomationProperties.IsInAccessibleTree="False"
                            IsVisible="False"
                            VerticalOptions="Center">
                            <ui:MaterialIconView.Triggers>
                                <DataTrigger Binding="{Binding IsDetailExpanded, Source={x:Reference Root}}" TargetType="ui:MaterialIconView" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ui:MaterialIconView.Triggers>
                        </ui:MaterialIconView>
                    </Grid>
                </Grid>
                <testUi:QuestionnaireResultDetailView
                    IsVisible="{Binding IsDetailExpanded, Source={x:Reference Root}}"
                    Questions="{Binding DetailQuestions, Source={x:Reference Root}}"
                    DurationText="{Binding DurationText, Source={x:Reference Root}}"
                    HasDuration="False" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasLuscherDetail, Source={x:Reference Root}}" Spacing="4">
                <!-- "More", not the summary again: the colours stood twice under each other, once black and once blue. -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    MinimumHeightRequest="44"
                    Padding="4,0"
                    SemanticProperties.Description="{Binding LuscherToggleText, Source={x:Reference Root}}"
                    SemanticProperties.Hint="{Binding LuscherToggleHint, Source={x:Reference Root}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLuscherDetailCommand, Source={x:Reference Root}}" />
                    </Grid.GestureRecognizers>
                    <Label
                        Text="{Binding LuscherToggleText, Source={x:Reference Root}}"
                        Style="{StaticResource CaptionStyle}"
                        FontFamily="{StaticResource MediumFontFamily}"
                        VerticalTextAlignment="Center"
                        TextColor="{DynamicResource Primary}" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="0">
                        <ui:MaterialIconView
                            IconName="ExpandMore"
                            IconSize="20"
                            IconColor="{DynamicResource Primary}"
                            AutomationProperties.IsInAccessibleTree="False"
                            VerticalOptions="Center">
                            <ui:MaterialIconView.Triggers>
                                <DataTrigger Binding="{Binding IsLuscherDetailExpanded, Source={x:Reference Root}}" TargetType="ui:MaterialIconView" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ui:MaterialIconView.Triggers>
                        </ui:MaterialIconView>
                        <ui:MaterialIconView
                            Grid.Column="1"
                            IconName="ExpandLess"
                            IconSize="20"
                            IconColor="{DynamicResource Primary}"
                            AutomationProperties.IsInAccessibleTree="False"
                            IsVisible="False"
                            VerticalOptions="Center">
                            <ui:MaterialIconView.Triggers>
                                <DataTrigger Binding="{Binding IsLuscherDetailExpanded, Source={x:Reference Root}}" TargetType="ui:MaterialIconView" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ui:MaterialIconView.Triggers>
                        </ui:MaterialIconView>
                    </Grid>
                </Grid>
                <testUi:LuscherHistoryDetailView
                    IsVisible="{Binding IsLuscherDetailExpanded, Source={x:Reference Root}}"
                    HasStandardDetail="{Binding HasStandardLuscherDetail, Source={x:Reference Root}}"
                    HasBriefDetail="{Binding HasBriefLuscherDetail, Source={x:Reference Root}}"
                    StandardDetail="{Binding LuscherStandardDetail, Source={x:Reference Root}}"
                    BriefDetail="{Binding LuscherBriefDetail, Source={x:Reference Root}}"
                    FirstPassTitle="{Binding LuscherFirstPassTitle, Source={x:Reference Root}}"
                    SecondPassTitle="{Binding LuscherSecondPassTitle, Source={x:Reference Root}}"
                    BkText="{Binding LuscherBkText, Source={x:Reference Root}}"
                    BriefFirstRoleLabel="{Binding LuscherBriefFirstRoleLabel, Source={x:Reference Root}}"
                    BriefSecondRoleLabel="{Binding LuscherBriefSecondRoleLabel, Source={x:Reference Root}}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
