<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="PsychologyApp.Presentation.Shared.UI.Overlays.AppOptionsSheetPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid
        x:Name="SheetHost"
        RowDefinitions="*,Auto"
        VerticalOptions="Fill"
        HorizontalOptions="Fill">
        <BoxView Grid.RowSpan="2" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid
            x:Name="SheetCardHost"
            Grid.Row="1"
            Margin="16,0,16,48"
            HorizontalOptions="Fill"
            VerticalOptions="End">
            <Border
                x:Name="SheetCard"
                Style="{StaticResource AppOptionsSheetPopupCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Label
                        x:Name="TitleLabel"
                        Style="{StaticResource AppOptionsSheetTitleStyle}"
                        Margin="0,0,0,4" />

                    <BoxView Style="{StaticResource AppDialogDividerStyle}" />

                    <Label x:Name="SelectionSummaryLabel"
                           Style="{StaticResource CaptionStyle}"
                           Margin="12,6"
                           IsVisible="False" />

                    <ScrollView x:Name="OptionsScroll"
                                VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="OptionsStack"
                                             Spacing="0" />
                    </ScrollView>

                    <Label x:Name="SelectionLimitLabel"
                           Style="{StaticResource CaptionStyle}"
                           Margin="12,6"
                           IsVisible="False" />

                    <BoxView Style="{StaticResource AppDialogDividerStyle}" />

                    <Grid x:Name="FooterActions" ColumnDefinitions="*,*">
                        <Border x:Name="AcceptHost"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                MinimumHeightRequest="48"
                                Padding="0,4"
                                IsVisible="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAcceptTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="AcceptLabel"
                                   Style="{StaticResource AppDialogPrimaryActionLabelStyle}"
                                   InputTransparent="True" />
                        </Border>
                        <Border x:Name="CancelHost"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                MinimumHeightRequest="48"
                                Padding="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="CancelLabel"
                                   Style="{StaticResource AppDialogPrimaryActionLabelStyle}"
                                   InputTransparent="True" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</toolkit:Popup>
