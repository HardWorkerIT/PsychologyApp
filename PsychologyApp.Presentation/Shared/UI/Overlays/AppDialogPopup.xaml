<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
               x:Class="PsychologyApp.Presentation.Shared.UI.Overlays.AppDialogPopup"
               x:Name="Root"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid
        x:Name="DialogCardHost"
        Margin="32"
        VerticalOptions="Center"
        HorizontalOptions="Center">
        <Border
            x:Name="DialogCard"
            Style="{StaticResource AppDialogPopupCardStyle}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <VerticalStackLayout Spacing="0">
                <Border
                    x:Name="SheetGrabber"
                    WidthRequest="36"
                    HeightRequest="4"
                    Margin="0,10,0,8"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                <VerticalStackLayout
                    Padding="20,20,20,16"
                    Spacing="8">
                    <Label
                        x:Name="TitleLabel"
                        Style="{StaticResource AppDialogTitleStyle}" />
                    <Label
                        x:Name="MessageLabel"
                        Style="{StaticResource AppDialogMessageStyle}" />
                    <Border
                        x:Name="InputBorder"
                        IsVisible="False"
                        Style="{StaticResource InputBorderStyle}"
                        Padding="10,2">
                        <Entry
                            x:Name="InputEntry"
                            ReturnType="Done"
                            Completed="OnEntryCompleted"
                            Style="{StaticResource InputTextStyle}" />
                    </Border>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource AppDialogDividerStyle}" />

                <Grid
                    x:Name="ButtonRow"
                    ColumnDefinitions="*,Auto,*"
                    MinimumHeightRequest="44">
                    <Border
                        x:Name="CancelTapArea"
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="CancelLabel"
                            Style="{StaticResource AppDialogActionLabelStyle}"
                            InputTransparent="True" />
                    </Border>

                    <BoxView
                        x:Name="ActionDivider"
                        Grid.Column="1"
                        Style="{StaticResource AppDialogActionDividerStyle}" />

                    <Border
                        x:Name="AcceptTapArea"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAcceptTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="AcceptLabel"
                            Style="{StaticResource AppDialogPrimaryActionLabelStyle}"
                            InputTransparent="True" />
                    </Border>
                </Grid>

                <VerticalStackLayout
                    x:Name="SheetActions"
                    IsVisible="False"
                    Padding="20,0,20,16"
                    Spacing="8">
                    <ui:ButtonView x:Name="SheetAcceptButton" />
                    <ui:ButtonView x:Name="SheetCancelButton" Variant="Secondary" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>

</toolkit:Popup>
