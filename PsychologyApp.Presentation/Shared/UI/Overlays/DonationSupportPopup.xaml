<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
               x:Class="PsychologyApp.Presentation.Shared.UI.Overlays.DonationSupportPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">
    <Grid x:Name="SheetHost" RowDefinitions="*,Auto" VerticalOptions="Fill" HorizontalOptions="Fill">
        <BoxView Grid.RowSpan="2" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SheetCardHost"
              Grid.Row="1"
              Margin="16,0,16,48"
              HorizontalOptions="Fill"
              VerticalOptions="End">
            <Border Style="{StaticResource AppOptionsSheetPopupCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Border WidthRequest="36"
                            HeightRequest="4"
                            Margin="0,10,0,8"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <Label x:Name="TitleLabel"
                           Style="{StaticResource AppOptionsSheetTitleStyle}"
                           Margin="0,0,0,4" />
                    <BoxView Style="{StaticResource AppDialogDividerStyle}" />

                    <ScrollView x:Name="ContentScroll" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Padding="16,8,16,12" Spacing="12">
                            <Label x:Name="IntroLabel" Style="{StaticResource BodyStyle}" />

                            <Border Padding="12"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="PaymentMethodLabel"
                                           Style="{StaticResource CaptionStyle}"
                                           FontFamily="{StaticResource SemiBoldFontFamily}" />
                                    <Label x:Name="RecipientLabel" Style="{StaticResource BodyStyle}" />
                                </VerticalStackLayout>
                            </Border>

                            <Label x:Name="BankCheckNoteLabel"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalTextAlignment="Center" />
                            <ui:ButtonView x:Name="OpenSberButton" Variant="Primary" />
                            <ui:ButtonView x:Name="CopyNumberButton" Variant="Secondary" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <BoxView Style="{StaticResource AppDialogDividerStyle}" />
                    <Border x:Name="CancelHost"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            MinimumHeightRequest="48"
                            Padding="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="CancelLabel"
                               Style="{StaticResource AppDialogPrimaryActionLabelStyle}"
                               InputTransparent="True" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</toolkit:Popup>
