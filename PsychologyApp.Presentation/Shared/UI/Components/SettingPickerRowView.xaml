<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:SettingPickerRowView"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.SettingPickerRowView"
             x:Name="Root">

    <Grid MinimumHeightRequest="52" ColumnSpacing="12" Opacity="{Binding RowOpacity, Source={x:Reference Root}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label
            x:Name="SettingLabel"
            Grid.Column="0"
            Text="{Binding LabelText, Source={x:Reference Root}}"
            Style="{StaticResource BodyStyle}"
            VerticalOptions="Center"
            LineBreakMode="TailTruncation"
            MaxLines="2" />
        <Grid
            Grid.Column="1"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            ColumnDefinitions="*,Auto">
            <Button
                x:Name="SelectionButton"
                Grid.ColumnSpan="2"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                BackgroundColor="Transparent"
                FontSize="15"
                Padding="0,0,24,0"
                CornerRadius="0"
                BorderWidth="0"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="End"
                VerticalOptions="Center"
                IsEnabled="{Binding IsRowEnabled, Source={x:Reference Root}}"
                Clicked="OnSelectionButtonClicked" />
            <Label
                Grid.Column="1"
                Text="⌄"
                Style="{StaticResource BodyStyle}"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                VerticalOptions="Center"
                InputTransparent="True"
                AutomationProperties.IsInAccessibleTree="False" />
        </Grid>
    </Grid>

</ContentView>
