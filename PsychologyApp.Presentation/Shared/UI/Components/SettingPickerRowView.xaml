<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:SettingPickerRowView"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.SettingPickerRowView"
             x:Name="Root">

    <Grid MinimumHeightRequest="52" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label
            x:Name="SettingLabel"
            Grid.Column="0"
            Text="{Binding LabelText, Source={x:Reference Root}}"
            Style="{StaticResource BodyStyle}"
            VerticalOptions="Center"
            LineBreakMode="TailTruncation"
            MaxLines="2" />
        <Grid
            Grid.Column="1"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            ColumnDefinitions="*,Auto">
            <Label
                x:Name="SelectedValueLabel"
                Grid.Column="0"
                FontSize="15"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                HorizontalTextAlignment="End"
                VerticalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                InputTransparent="True"
                AutomationProperties.IsInAccessibleTree="False">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding IsRowEnabled, Source={x:Reference Root}}"
                        TargetType="Label"
                        Value="False">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <self:MaterialIconView
                Grid.Column="1"
                IconName="ExpandMore"
                IconSize="18"
                IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                InputTransparent="True"
                AutomationProperties.IsInAccessibleTree="False">
                <self:MaterialIconView.Triggers>
                    <DataTrigger
                        Binding="{Binding IsRowEnabled, Source={x:Reference Root}}"
                        TargetType="self:MaterialIconView"
                        Value="False">
                        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </DataTrigger>
                </self:MaterialIconView.Triggers>
            </self:MaterialIconView>
            <Border
                x:Name="SelectionTapArea"
                Grid.ColumnSpan="2"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                MinimumHeightRequest="44"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                IsEnabled="{Binding IsRowEnabled, Source={x:Reference Root}}"
                SemanticProperties.Description="{Binding PickerAccessibilityDescription, Source={x:Reference Root}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSelectionAreaTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Grid>

</ContentView>
