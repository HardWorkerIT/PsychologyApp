<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:FilterChipView"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.FilterChipView"
             x:Name="Root"
             HorizontalOptions="Start">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" ScaleOnly="True" />
    </ContentView.Behaviors>

    <Border
        HorizontalOptions="Start"
        Style="{StaticResource FilterChipStyle}">
        <Border.Triggers>
            <DataTrigger
                Binding="{Binding IsSelected, Source={x:Reference Root}}"
                TargetType="Border"
                Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding TapCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label
            Text="{Binding TitleText, Source={x:Reference Root}}"
            Style="{StaticResource FilterChipLabelStyle}">
            <Label.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected, Source={x:Reference Root}}"
                    TargetType="Label"
                    Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
