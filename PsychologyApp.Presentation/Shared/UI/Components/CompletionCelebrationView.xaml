<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.CompletionCelebrationView">

    <ContentView.Behaviors>
        <behaviors:EmptyStateRevealBehavior />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="self:CompletionCelebrationView">
            <Grid
                Padding="20,0,20,12"
                RowDefinitions="Auto,Auto"
                VerticalOptions="Start">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="0,12,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="{StaticResource CompactSpacing}"
                    MaximumWidthRequest="320">
                    <Border
                        x:Name="IconHalo"
                        Style="{StaticResource EmptyStateIconHaloStyle}">
                        <ui:MaterialIconView
                            IconName="{TemplateBinding IconName}"
                            IconSize="32"
                            IconColor="{DynamicResource Primary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Text="{TemplateBinding TitleText}"
                        Style="{StaticResource PageTitleStyle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{TemplateBinding BodyText}"
                        Style="{StaticResource BodyStyle}"
                        HorizontalTextAlignment="Center" />
                    <FlexLayout
                        IsVisible="{TemplateBinding HasStreak}"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Center"
                        HorizontalOptions="Center">
                        <Label
                            Text="{TemplateBinding StreakLabelText}"
                            Margin="0,0,6,0"
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="{TemplateBinding StreakValueText}"
                            Style="{StaticResource CaptionStyle}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            HorizontalTextAlignment="Center" />
                    </FlexLayout>
                </VerticalStackLayout>
                <ui:ConfettiBurstView
                    x:Name="Confetti"
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start" />
                <ui:ButtonView
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsVisible="{TemplateBinding IsPrimaryActionVisible}"
                    BodyText="{TemplateBinding PrimaryActionText}"
                    TapCommand="{TemplateBinding PrimaryCommand}" />
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
