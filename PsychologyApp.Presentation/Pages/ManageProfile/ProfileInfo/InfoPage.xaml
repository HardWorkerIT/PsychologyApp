<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileInfo.InfoPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileInfo"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:InfoViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">
    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource CompactSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,0,0,8">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <VerticalStackLayout Spacing="4" Padding="0,8,0,10" HorizontalOptions="Center">
                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 17"
                        AutomationProperties.IsInAccessibleTree="False">
                        <Label Text="Ψ"
                               FontSize="28"
                               FontFamily="{StaticResource SemiBoldFontFamily}"
                               TextColor="{DynamicResource PrimaryFill}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding PageTitle}" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Tagline}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding PurposeTitle}"
                           Style="{StaticResource CaptionStyle}"
                           FontFamily="{StaticResource SemiBoldFontFamily}"
                           Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <Label Text="{Binding AboutBody}" Style="{StaticResource BodyStyle}" />
                    </Border>
                </VerticalStackLayout>

                <Border
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                    <Label Text="{Binding Disclaimer}"
                           Style="{StaticResource CaptionStyle}"
                           LineBreakMode="WordWrap" />
                </Border>

                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0"
                        SemanticProperties.Description="{Binding PrivacyPolicyTitle}">
                    <Border.Behaviors>
                        <behaviors:PressFeedbackBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Border WidthRequest="32" HeightRequest="32" Padding="6"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <ui:MaterialIconView IconName="Policy" IconSize="18" IconColor="{DynamicResource Primary}" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding PrivacyPolicyTitle}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>

                <Label Text="{Binding AppVersionText}"
                       Style="{StaticResource CaptionStyle}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
