<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileUser.UserPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileUser"
             xmlns:technique="clr-namespace:PsychologyApp.Presentation.Entities.Technique"
             xmlns:profile="clr-namespace:PsychologyApp.Presentation.Entities.Profile"
             xmlns:quotes="clr-namespace:PsychologyApp.Presentation.Entities.Quote"
             xmlns:quoteCard="clr-namespace:PsychologyApp.Presentation.Widgets.QuoteCard"
             xmlns:profileUi="clr-namespace:PsychologyApp.Presentation.Widgets.ProfileTechniqueCard"
             xmlns:profileHistory="clr-namespace:PsychologyApp.Presentation.Widgets.Profile"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:UserViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid VerticalOptions="FillAndExpand">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="ProfileContent"
                Margin="{StaticResource LayoutPageMarginThickness}"
                Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <ui:NavigationBarSimpleView
                    TitleText="{Binding PageTitle}"
                    BackCommand="{Binding Finish}" />

                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}" Margin="0,0,0,4">
                    <Label Text="{Binding ProfileJourneyTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding ProfileJourneySubtitle}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Label
                        Text="{Binding ProfileActivityTitle}"
                        Style="{StaticResource CaptionStyle}"
                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" Padding="12,8">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource CompactSpacing}">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" MinimumHeightRequest="44" VerticalOptions="Center">
                                <Label Text="{Binding TechniquesCompletedCount}" Style="{StaticResource EmphasisBodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TechniquesCompletedLabel}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                MinimumHeightRequest="44"
                                VerticalOptions="Center"
                                SemanticProperties.Description="{Binding TestsCompletedAccessibilityText}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTestsListCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <VerticalStackLayout.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </VerticalStackLayout.Behaviors>
                                <Label Text="{Binding TestsCompletedCount}" Style="{StaticResource EmphasisBodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TestsCompletedLabel}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" MinimumHeightRequest="44" VerticalOptions="Center">
                                <Label Text="{Binding ActiveDaysCount}" Style="{StaticResource EmphasisBodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding ActiveDaysLabel}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- The safety self-check stays one tap away; the week review that stood around it repeated the journal. -->
                <ui:SettingsLinkCardView
                    Title="{Binding ProfileRiskCheckLabel}"
                    Subtitle="{Binding ProfileRiskCheckSubtitle}"
                    IconName="FactCheck"
                    TapCommand="{Binding OpenRiskCheckCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:SectionHeaderView
                        TitleText="{Binding PracticeHistoryTitle}"
                        ActionText="{Binding PracticeHistoryActionText}"
                        ActionCommand="{Binding OpenPracticeHistoryCommand}" />
                    <Border
                        IsVisible="{Binding ShowPracticeHistoryEmpty}"
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Margin="0"
                        Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ui:MaterialIconView
                                IconName="History"
                                IconSize="22"
                                VerticalOptions="Center"
                                IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding PracticeHistoryEmpty}"
                                Style="{StaticResource CaptionStyle}"
                                VerticalTextAlignment="Center"
                                LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout
                        IsVisible="{Binding HasPracticeHistory}"
                        BindableLayout.ItemsSource="{Binding PracticeHistory}"
                        Spacing="{StaticResource ListItemSpacing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="profile:PracticeHistoryItem">
                                <profileHistory:ProfileHistoryEntryView
                                    DateText="{Binding DateText}"
                                    TechniqueName="{Binding TechniqueName}"
                                    IconName="{Binding IconName}"
                                    DurationText="{Binding DurationText}"
                                    HasDuration="{Binding HasDuration}"
                                    SudsDeltaText="{Binding SudsDeltaText}"
                                    HasSudsDelta="{Binding HasSudsDelta}"
                                    TapCommand="{Binding TapCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:SectionHeaderView TitleText="{Binding ProfileRecommendationTitle}" />
                    <profileUi:ProfileTechniqueCardView
                        IsVisible="{Binding HasFeaturedTechnique}"
                        HorizontalOptions="Fill"
                        CardWidth="-1"
                        Image="{Binding FeaturedTechnique.Image}"
                        IconName="{Binding FeaturedTechnique.IconName}"
                        Title="{Binding FeaturedTechnique.Title}"
                        Subtitle="{Binding FeaturedTechnique.Subtitle}"
                        Theme="{Binding FeaturedTechnique.MetaText}"
                        Flavor="{Binding FeaturedTechnique.Flavor}"
                        TapCommand="{Binding FeaturedTechnique.TapCommand}"
                        SemanticProperties.Description="{Binding FeaturedTechnique.AccessibilityDescription}">
                        <profileUi:ProfileTechniqueCardView.Behaviors>
                            <behaviors:ListItemRevealBehavior />
                        </profileUi:ProfileTechniqueCardView.Behaviors>
                    </profileUi:ProfileTechniqueCardView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:SectionHeaderView
                        TitleText="{Binding BestQuotesLabel}"
                        SubtitleText="{Binding QuotesSectionSubtitle}"
                        ActionText="{Binding QuotesSectionActionText}"
                        ActionCommand="{Binding OpenQuotesFavoritesCommand}" />

                    <ui:ProgressBarView
                        IsVisible="{Binding IsQuotesLoading}"
                        IsLoading="{Binding IsQuotesLoading}"
                        ProgressText="{Binding QuotesLoadingText}"
                        CancelCommand="{Binding CancelQuotesCommand}" />

                    <Border
                        IsVisible="{Binding ShowQuotesEmpty}"
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Margin="0"
                        Padding="14,12"
                        SemanticProperties.Description="{Binding QuotesEmptyAccessibilityText}"
                        SemanticProperties.Hint="{Binding GoToQuotesTabText}">
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenQuotesTabCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource PrimaryTint}"
                                StrokeShape="{DynamicResource UiCornerRadiusCompactShape}"
                                VerticalOptions="Center">
                                <ui:MaterialIconView
                                    IconName="FavoriteBorder"
                                    IconSize="20"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding QuotesEmptyText}" Style="{StaticResource ListRowTitleStyle}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding QuotesEmptyHint}" Style="{StaticResource CaptionStyle}" LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding GoToQuotesTabText}"
                                    FontSize="{DynamicResource CaptionFontSize}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}"
                                    TextColor="{DynamicResource Primary}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView
                                Grid.Column="2"
                                IconName="ChevronRight"
                                IconSize="20"
                                VerticalOptions="Center"
                                IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        IsVisible="{Binding ShowQuotesPreview}"
                        BindableLayout.ItemsSource="{Binding DisplayQuotes}"
                        Spacing="{StaticResource ListItemSpacing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="quotes:QuoteItem">
                                <quoteCard:QuoteCardView
                                    Text="{Binding Text}"
                                    Author="{Binding Author}"
                                    IsFavourite="{Binding IsFavourite}"
                                    LikeCommand="{Binding LikeCommand}"
                                    CopyCommand="{Binding CopyCommand}"
                                    ShareCommand="{Binding ShareCommand}">
                                    <quoteCard:QuoteCardView.Behaviors>
                                        <behaviors:ListItemRevealBehavior />
                                    </quoteCard:QuoteCardView.Behaviors>
                                </quoteCard:QuoteCardView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding LoadErrorText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding ReloadCommand}" />

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsQuotesFailed}"
            FailedText="{Binding LoadErrorText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding ReloadQuotesCommand}" />

        <ui:SkeletonView
            Kind="Profile"
            Margin="{StaticResource LayoutPageMarginThickness}"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            IsActive="{Binding IsLoadingOverlayVisible}" />

        <ui:ProgressBarView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsSlowLoadingVisible}"
            IsLoading="{Binding IsSlowLoadingVisible}"
            ProgressText="{Binding LoadingText}" />
    </Grid>
</ContentPage>
