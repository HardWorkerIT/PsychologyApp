<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileDataBackup.DataBackupPage"
             SafeAreaEdges="All"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileDataBackup"
             x:DataType="vm:DataBackupViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DataIconTileStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}"
            Padding="0,0,0,8">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}" />

            <Label Text="{Binding LeadText}" Style="{StaticResource CaptionStyle}" Margin="4,0" />

            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAppLockOffered}">
                <Label Text="{Binding ProtectionSectionTitle}"
                       Style="{StaticResource CaptionStyle}"
                       FontFamily="{StaticResource SemiBoldFontFamily}"
                       Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                    <VerticalStackLayout Spacing="4" Padding="0,4">
                        <ui:SettingSwitchRowView
                            LabelText="{Binding AppLockLabel}"
                            IsToggled="{Binding AppLockEnabled}"
                            ShowDivider="False" />
                        <Label Text="{Binding AppLockHint}" Style="{StaticResource CaptionStyle}" />
                        <Button
                            Text="{Binding ChangeAppPinText}"
                            Command="{Binding ChangeAppPinCommand}"
                            IsVisible="{Binding IsAppPinManagementVisible}"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Padding="0,4"
                            MinimumHeightRequest="44"
                            HorizontalOptions="Start"
                            TextColor="{DynamicResource Primary}"
                            FontSize="{DynamicResource BodyFontSize}"
                            FontFamily="{StaticResource MediumFontFamily}"
                            SemanticProperties.Description="{Binding ChangeAppPinText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding BackupSectionTitle}"
                       Style="{StaticResource CaptionStyle}"
                       FontFamily="{StaticResource SemiBoldFontFamily}"
                       Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                              SemanticProperties.Description="{Binding ExportTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportBackupCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource DataIconTileStyle}"><ui:MaterialIconView IconName="Download" IconSize="18" IconColor="{DynamicResource Primary}" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,6">
                                <Label Text="{Binding ExportTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding ExportSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                              SemanticProperties.Description="{Binding ImportTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ImportBackupCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource DataIconTileStyle}"><ui:MaterialIconView IconName="Upload" IconSize="18" IconColor="{DynamicResource Primary}" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,6">
                                <Label Text="{Binding ImportTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding ImportSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding ShareSectionTitle}"
                       Style="{StaticResource CaptionStyle}"
                       FontFamily="{StaticResource SemiBoldFontFamily}"
                       Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                              SemanticProperties.Description="{Binding SummaryTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportSummaryCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource DataIconTileStyle}"><ui:MaterialIconView IconName="Summarize" IconSize="18" IconColor="{DynamicResource Primary}" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,6">
                                <Label Text="{Binding SummaryTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding SummarySubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                              SemanticProperties.Description="{Binding ErrorLogTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ShareErrorLogCommand}" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource DataIconTileStyle}"><ui:MaterialIconView IconName="ErrorOutline" IconSize="18" IconColor="{DynamicResource Primary}" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,6">
                                <Label Text="{Binding ErrorLogTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding ErrorLogSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6" Margin="0,4,0,0">
                <Label Text="{Binding IrreversibleSectionTitle}"
                       Style="{StaticResource CaptionStyle}"
                       FontFamily="{StaticResource SemiBoldFontFamily}"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                       Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                          SemanticProperties.Description="{Binding EraseTitle}">
                        <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EraseAllCommand}" /></Grid.GestureRecognizers>
                        <Border Style="{StaticResource DataIconTileStyle}"><ui:MaterialIconView IconName="DeleteForever" IconSize="18" IconColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" /></Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,6">
                            <Label Text="{Binding EraseTitle}" Style="{StaticResource BodyStyle}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            <Label Text="{Binding EraseSubtitle}" Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
