<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.AppLock.AppLockPage"
             SafeAreaEdges="All"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.AppLock"
             x:DataType="vm:AppLockViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="AppLockPinKeyStyle" TargetType="Button">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray600}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="18"
            Padding="0,20,0,20"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                <Border
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="10"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15"
                    SemanticProperties.Description="{Binding TitleText}">
                    <ui:MaterialIconView IconName="Lock" IconSize="28" IconColor="{DynamicResource PrimaryFill}" />
                </Border>
                <Label
                    Text="{Binding TitleText}"
                    Style="{StaticResource SectionTitleStyle}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="{Binding LeadText}"
                    Style="{StaticResource BodyStyle}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsPinEntryVisible}">
                <Label
                    Text="{Binding PinPromptText}"
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center" />
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding PinCells}"
                    Spacing="8"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{Binding PinProgressText}"
                    SemanticProperties.Hint="{Binding PinEntryDescription}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:Boolean">
                            <Border
                                WidthRequest="32"
                                HeightRequest="42"
                                StrokeThickness="1.5"
                                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                                <Border.Triggers>
                                    <DataTrigger Binding="{Binding .}" TargetType="Border" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                        <Setter Property="Stroke" Value="{DynamicResource PrimaryFill}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Ellipse
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    Fill="{DynamicResource PrimaryFill}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding .}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Grid
                    IsEnabled="{Binding CanEnterPin}"
                    WidthRequest="240"
                    HorizontalOptions="Center"
                    RowDefinitions="56,56,56,56"
                    ColumnDefinitions="*,*,*"
                    RowSpacing="5"
                    ColumnSpacing="5"
                    SemanticProperties.Description="{Binding PinPromptText}">
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" Text="1" Command="{Binding AddPinDigitCommand}" CommandParameter="1" />
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" Text="2" Command="{Binding AddPinDigitCommand}" CommandParameter="2" />
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" Text="3" Command="{Binding AddPinDigitCommand}" CommandParameter="3" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" Text="4" Command="{Binding AddPinDigitCommand}" CommandParameter="4" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" Text="5" Command="{Binding AddPinDigitCommand}" CommandParameter="5" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" Text="6" Command="{Binding AddPinDigitCommand}" CommandParameter="6" />
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" Text="7" Command="{Binding AddPinDigitCommand}" CommandParameter="7" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" Text="8" Command="{Binding AddPinDigitCommand}" CommandParameter="8" />
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" Text="9" Command="{Binding AddPinDigitCommand}" CommandParameter="9" />
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" Text="0" Command="{Binding AddPinDigitCommand}" CommandParameter="0" />
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" Text="⌫" FontSize="22" IsEnabled="{Binding CanDeletePin}" Command="{Binding DeletePinDigitCommand}" SemanticProperties.Description="{Binding DeletePinDigitText}" />
                </Grid>

                <Label
                    Text="{Binding StatusText}"
                    TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                    FontSize="{DynamicResource CaptionFontSize}"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding HasStatus}" />
                <ui:ButtonView
                    Variant="Secondary"
                    IsCompact="True"
                    BodyText="{Binding RecoveryText}"
                    TapCommand="{Binding RecoverPinCommand}"
                    IsVisible="{Binding HasSystemRecovery}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
