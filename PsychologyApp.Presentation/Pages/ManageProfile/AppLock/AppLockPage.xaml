<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.AppLock.AppLockPage"
             SafeAreaEdges="All"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.AppLock"
             x:DataType="vm:AppLockViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="AppLockPinKeyStyle" TargetType="ui:ButtonView">
                <Setter Property="WidthRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Variant" Value="Tonal" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="16"
            Padding="0,24,0,28"
            VerticalOptions="Center">
            <!-- Keep the calm chat illustration from the previous lock screen; PIN entry remains the actual unlock path. -->
            <Grid
                WidthRequest="280"
                HeightRequest="176"
                HorizontalOptions="Center"
                RowDefinitions="*,*,*"
                ColumnDefinitions="*,*"
                AutomationProperties.IsInAccessibleTree="False">
                <Grid.Behaviors>
                    <behaviors:EmptyStateRevealBehavior />
                </Grid.Behaviors>

                <Ellipse
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="2"
                    WidthRequest="144"
                    HeightRequest="144"
                    Fill="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border Grid.Row="0" Grid.Column="0" WidthRequest="156" HeightRequest="48" Padding="14,12"
                        HorizontalOptions="Start" VerticalOptions="Center" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18,18,4,18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="104" HeightRequest="6" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                        <BoxView WidthRequest="68" HeightRequest="6" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" WidthRequest="144" HeightRequest="48" Padding="14,12"
                        HorizontalOptions="End" VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{DynamicResource PrimaryFill}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18,18,18,4" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="94" HeightRequest="6" CornerRadius="3" Color="White" Opacity="0.78" HorizontalOptions="Start" />
                        <BoxView WidthRequest="62" HeightRequest="6" CornerRadius="3" Color="White" Opacity="0.58" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" WidthRequest="158" HeightRequest="48" Padding="14,12" Margin="12,0,0,0"
                        HorizontalOptions="Start" VerticalOptions="Center" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18,18,4,18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="110" HeightRequest="6" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                        <BoxView WidthRequest="76" HeightRequest="6" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" WidthRequest="68" HeightRequest="68" Padding="15" Margin="0,0,4,0"
                        HorizontalOptions="End" VerticalOptions="End"
                        Stroke="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                        StrokeThickness="5" StrokeShape="RoundRectangle 34"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}">
                    <ui:MaterialIconView IconName="Lock" IconSize="34" IconColor="{DynamicResource PrimaryFill}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                <Label
                    Text="{Binding TitleText}"
                    Style="{StaticResource SectionTitleStyle}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="{Binding LeadText}"
                    Style="{StaticResource BodyStyle}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="PinEntryPanel" Spacing="8" IsVisible="{Binding IsPinEntryVisible}">
                <HorizontalStackLayout
                    x:Name="PinCellsLayout"
                    BindableLayout.ItemsSource="{Binding PinCells}"
                    Spacing="8"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{Binding PinProgressText}"
                    SemanticProperties.Hint="{Binding PinEntryDescription}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:Boolean">
                            <Border
                                WidthRequest="32"
                                HeightRequest="42"
                                StrokeThickness="1.5"
                                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                                <Border.Triggers>
                                    <DataTrigger Binding="{Binding .}" TargetType="Border" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                        <Setter Property="Stroke" Value="{DynamicResource PrimaryFill}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Ellipse
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    Fill="{DynamicResource PrimaryFill}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding .}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Grid
                    IsEnabled="{Binding CanEnterPin}"
                    WidthRequest="248"
                    HorizontalOptions="Center"
                    RowDefinitions="64,64,64,64"
                    ColumnDefinitions="*,*,*"
                    RowSpacing="8"
                    ColumnSpacing="8"
                    SemanticProperties.Description="{Binding PinPromptText}">
                    <ui:ButtonView Grid.Row="0" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" BodyText="1" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="1" />
                    <ui:ButtonView Grid.Row="0" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" BodyText="2" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="2" />
                    <ui:ButtonView Grid.Row="0" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" BodyText="3" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="3" />
                    <ui:ButtonView Grid.Row="1" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" BodyText="4" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="4" />
                    <ui:ButtonView Grid.Row="1" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" BodyText="5" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="5" />
                    <ui:ButtonView Grid.Row="1" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" BodyText="6" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="6" />
                    <ui:ButtonView Grid.Row="2" Grid.Column="0" Style="{StaticResource AppLockPinKeyStyle}" BodyText="7" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="7" />
                    <ui:ButtonView Grid.Row="2" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" BodyText="8" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="8" />
                    <ui:ButtonView Grid.Row="2" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" BodyText="9" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="9" />
                    <ui:ButtonView Grid.Row="3" Grid.Column="1" Style="{StaticResource AppLockPinKeyStyle}" BodyText="0" TapCommand="{Binding AddPinDigitCommand}" CommandParameter="0" />
                    <ui:ButtonView Grid.Row="3" Grid.Column="2" Style="{StaticResource AppLockPinKeyStyle}" BodyText="⌫" IsEnabled="{Binding CanDeletePin}" TapCommand="{Binding DeletePinDigitCommand}" AccessibilityLabel="{Binding DeletePinDigitText}" />
                </Grid>

                <Label
                    Text="{Binding StatusText}"
                    TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                    FontSize="{DynamicResource CaptionFontSize}"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding HasStatus}" />
                <ui:ButtonView
                    Variant="Secondary"
                    IsCompact="True"
                    BodyText="{Binding RecoveryText}"
                    TapCommand="{Binding RecoverPinCommand}"
                    IsVisible="{Binding HasSystemRecovery}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
