<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileSettings.SettingsPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileSettings"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:converters="clr-namespace:PsychologyApp.Presentation.Shared.UI.Converters"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource CompactSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding Finish}" />

        <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,0,0,8">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="0" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="0">
                    <Label
                        Text="{Binding DesignSectionTitle}"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,10" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.Theme}"
                        LabelText="{Binding ThemeLabel}"
                        PickerTitle="{Binding ThemePickerTitle}"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding Theme}"
                        SelectionRequested="OnSettingSelectionRequested" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.Form}"
                        LabelText="{Binding FormLabel}"
                        PickerTitle="{Binding FormPickerTitle}"
                        ItemsSource="{Binding FormOptions}"
                        SelectedItem="{Binding Form}"
                        SelectionRequested="OnSettingSelectionRequested" />
                    <Label
                        Text="{Binding FormHelperText}"
                        Style="{StaticResource CaptionStyle}"
                        Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="1" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="0">
                    <Label
                        Text="{Binding FontSectionTitle}"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,10" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.Size}"
                        LabelText="{Binding SizeLabel}"
                        PickerTitle="{Binding SizePickerTitle}"
                        ItemsSource="{Binding SizeOptions}"
                        SelectedItem="{Binding Size}"
                        SelectionRequested="OnSettingSelectionRequested" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                    <ui:SettingSwitchRowView
                        LabelText="{Binding BoldLabel}"
                        IsToggled="{Binding IsThick}"
                        ShowDivider="False" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="2" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="0">
                    <Label
                        Text="{Binding PrimaryConcernSectionTitle}"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,10" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.Concern}"
                        LabelText="{Binding PrimaryConcernLabel}"
                        PickerTitle="{Binding PrimaryConcernPickerTitle}"
                        ItemsSource="{Binding OnboardingConcernOptions}"
                        SelectedItem="{Binding OnboardingConcern}"
                        SelectionRequested="OnSettingSelectionRequested" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.Language}"
                        LabelText="{Binding LanguageLabel}"
                        PickerTitle="{Binding LanguagePickerTitle}"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding Language}"
                        SelectionRequested="OnSettingSelectionRequested" />
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding AreRemindersSupported}"
                Style="{StaticResource SettingsSectionCardStyle}"
                Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="3" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="0">
                    <Label
                        Text="{Binding RemindersSectionTitle}"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,10" />

                    <ui:SettingSwitchRowView
                        LabelText="{Binding PracticeRemindersLabel}"
                        IsToggled="{Binding PracticeRemindersEnabled}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.PassThrough}"
                        LabelText="{Binding PracticeReminderHourLabel}"
                        PickerTitle="{Binding PracticeReminderHourPickerTitle}"
                        ItemsSource="{Binding PracticeReminderHourOptions}"
                        SelectedItem="{Binding PracticeReminderHour}"
                        SelectionRequested="OnSettingSelectionRequested"
                        IsRowEnabled="{Binding PracticeRemindersEnabled}" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />

                    <ui:SettingSwitchRowView
                        LabelText="{Binding QuoteRemindersLabel}"
                        IsToggled="{Binding QuoteRemindersEnabled}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.PassThrough}"
                        LabelText="{Binding QuoteReminderHourLabel}"
                        PickerTitle="{Binding QuoteReminderHourPickerTitle}"
                        ItemsSource="{Binding QuoteReminderHourOptions}"
                        SelectedItem="{Binding QuoteReminderHour}"
                        SelectionRequested="OnSettingSelectionRequested"
                        IsRowEnabled="{Binding QuoteRemindersEnabled}" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />

                    <ui:SettingSwitchRowView
                        LabelText="{Binding MoodRemindersLabel}"
                        IsToggled="{Binding MoodRemindersEnabled}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.PassThrough}"
                        LabelText="{Binding MoodReminderHourLabel}"
                        PickerTitle="{Binding MoodReminderHourPickerTitle}"
                        ItemsSource="{Binding MoodReminderHourOptions}"
                        SelectedItem="{Binding MoodReminderHour}"
                        SelectionRequested="OnSettingSelectionRequested"
                        IsRowEnabled="{Binding MoodRemindersEnabled}" />
                    <BoxView Style="{StaticResource SettingRowDividerStyle}" />

                    <ui:SettingSwitchRowView
                        LabelText="{Binding ChatRemindersLabel}"
                        IsToggled="{Binding ChatRemindersEnabled}" />
                    <ui:SettingPickerRowView
                        LabelKind="{x:Static converters:PreferenceLabelKind.PassThrough}"
                        LabelText="{Binding ChatReminderHourLabel}"
                        PickerTitle="{Binding ChatReminderHourPickerTitle}"
                        ItemsSource="{Binding ChatReminderHourOptions}"
                        SelectedItem="{Binding ChatReminderHour}"
                        SelectionRequested="OnSettingSelectionRequested"
                        IsRowEnabled="{Binding ChatRemindersEnabled}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="4" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="0">
                    <Label
                        Text="{Binding TestsSectionTitle}"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,10" />
                    <ui:SettingSwitchRowView
                        LabelText="{Binding QuestionnaireAutoAdvanceLabel}"
                        IsToggled="{Binding QuestionnaireAutoAdvance}"
                        ShowDivider="False" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" IsVisible="{Binding CanOfferAds}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding AdsTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding AdsHelp}" Style="{StaticResource CaptionStyle}" />
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding AdsDisclosure}" Style="{StaticResource CaptionStyle}" />
                        <ui:ButtonView Variant="Secondary" BodyText="{Binding AdsPrivacyPolicyText}"
                                       TapCommand="{Binding OpenAdsPrivacyPolicyCommand}" />
                    </VerticalStackLayout>
                    <Entry Text="{Binding AdCode}" Placeholder="{Binding AdCodePlaceholder}"
                           IsVisible="{Binding CanEnterAdCode}" MaxLength="40"
                           SemanticProperties.Description="{Binding AdCodePlaceholder}" />
                    <ui:ButtonView Variant="Secondary" BodyText="{Binding ApplyAdCodeText}"
                                   TapCommand="{Binding ApplyAdCodeCommand}" IsVisible="{Binding CanEnterAdCode}" />
                    <Label Text="{Binding AdCodeStatus}" Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>

            <ui:ButtonView
                Variant="Secondary"
                BodyText="{Binding ReplayOnboardingText}"
                TapCommand="{Binding ReplayOnboardingCommand}" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
