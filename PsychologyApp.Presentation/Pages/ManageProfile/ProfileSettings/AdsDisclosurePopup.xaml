<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
               xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
               x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileSettings.AdsDisclosurePopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid x:Name="SheetHost"
          RowDefinitions="*,Auto"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">
        <BoxView Grid.RowSpan="2" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SheetCardHost"
              Grid.Row="1"
              Margin="16,0,16,48"
              HorizontalOptions="Fill"
              VerticalOptions="End">
            <Border x:Name="SheetCard" Style="{StaticResource AppOptionsSheetPopupCardStyle}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="0">
                    <Border Grid.Row="0"
                            WidthRequest="36"
                            HeightRequest="4"
                            Margin="0,10,0,8"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                    <Grid Grid.Row="1" ColumnDefinitions="44,*,44" Padding="12,8,12,8" MinimumHeightRequest="60">
                        <Label x:Name="TitleLabel"
                               Grid.Column="1"
                               Style="{StaticResource AppOptionsSheetTitleStyle}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               Margin="8,0" />
                        <Border x:Name="CloseButton"
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                MinimumHeightRequest="44"
                                MinimumWidthRequest="44"
                                SemanticProperties.Description="Close">
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped" />
                            </Border.GestureRecognizers>
                            <ui:MaterialIconView IconName="Close"
                                                 IconSize="22"
                                                 IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                 InputTransparent="True" />
                        </Border>
                    </Grid>

                    <BoxView Grid.Row="2" Style="{StaticResource AppDialogDividerStyle}" />

                    <ScrollView x:Name="DisclosureScroll"
                                Grid.Row="3"
                                VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="20" Padding="20,18,20,20">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="MayReceiveTitleLabel" Style="{StaticResource EmphasisBodyStyle}" />
                                <Label x:Name="MayReceiveBodyLabel"
                                       Style="{StaticResource BodyStyle}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="OnDeviceTitleLabel" Style="{StaticResource EmphasisBodyStyle}" />
                                <Label x:Name="OnDeviceBodyLabel"
                                       Style="{StaticResource BodyStyle}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Border x:Name="PrivacyPolicyLink"
                            Grid.Row="4"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            MinimumHeightRequest="48"
                            Padding="20,6"
                            SemanticProperties.Description="Privacy policy">
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <ui:MaterialIconView IconName="Policy"
                                                 IconSize="18"
                                                 IconColor="{DynamicResource Primary}"
                                                 InputTransparent="True" />
                            <Label x:Name="PrivacyPolicyLabel"
                                   Grid.Column="1"
                                   Style="{StaticResource BodyStyle}"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalTextAlignment="Center"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>

                    <BoxView Grid.Row="5" Style="{StaticResource AppDialogDividerStyle}" />

                    <ui:ButtonView x:Name="DoneButton"
                                   Grid.Row="6"
                                   Variant="Primary"
                                   Margin="20,12,20,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</toolkit:Popup>
