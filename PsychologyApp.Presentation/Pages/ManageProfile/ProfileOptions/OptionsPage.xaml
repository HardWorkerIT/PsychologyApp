<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions.OptionsPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions"
             x:DataType="vm:OptionsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ProfileIconTileStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Rows grouped in cards, as the phone's own settings: a card with an icon tile for every row made seven heavy blocks. A row keeps a
         subtitle only when it says what is inside (settings, urgent help), not when it repeats the title. -->
    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource LayoutSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding AppSectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding SettingsTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSettingsPageCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource ProfileIconTileStyle}">
                                <ui:MaterialIconView IconName="Tune" IconSize="18" IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SettingsTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding SettingsSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="2" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding DataBackupTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDataBackupCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource ProfileIconTileStyle}">
                                <ui:MaterialIconView IconName="Backup" IconSize="18" IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DataBackupTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding DataBackupSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="2" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SafetySectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding CrisisTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCrisisHubCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource ProfileIconTileStyle}">
                                <ui:MaterialIconView IconName="HealthAndSafety" IconSize="18" IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CrisisTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding CrisisSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="2" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SupportSectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="60"
                                  IsVisible="{Binding CanSupportProject}"
                                  SemanticProperties.Description="{Binding DonationTitle}">
                                <Grid.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDonationCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource ProfileIconTileStyle}">
                                    <ui:MaterialIconView IconName="Favorite" IconSize="18" IconColor="{DynamicResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DonationTitle}" Style="{StaticResource BodyStyle}" />
                                    <Label Text="{Binding DonationSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="2" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingRowDividerStyle}" IsVisible="{Binding CanSupportProject}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding FeedbackTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFeedbackPageCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource ProfileIconTileStyle}">
                                <ui:MaterialIconView IconName="Feedback" IconSize="18" IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FeedbackTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding FeedbackSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="2" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding AboutTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAboutPageCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource ProfileIconTileStyle}">
                                <ui:MaterialIconView IconName="Psychology" IconSize="18" IconColor="{DynamicResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding AboutTitle}" Style="{StaticResource BodyStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding PrivacyNote}"
                       Style="{StaticResource CaptionStyle}"
                       Margin="4,0"
                       SemanticProperties.Description="{Binding PrivacyNote}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
