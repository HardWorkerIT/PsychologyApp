<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ClinicalCare.CrisisHub.CrisisHubPage"
             SafeAreaEdges="All"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ClinicalCare.CrisisHub"
             x:DataType="vm:CrisisHubViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="8">

            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}" />

            <Border
                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                StrokeThickness="0"
                Padding="14,12"
                SemanticProperties.Description="{Binding LeadText}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinimumHeightRequest="44">
                    <ui:MaterialIconView
                        IconName="HealthAndSafety"
                        IconSize="20"
                        IconColor="{DynamicResource Primary}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding LeadText}"
                        Style="{StaticResource BodyStyle}"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{Binding EmergencySectionTitle}"
                        Style="{StaticResource CaptionStyle}"
                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                    <Border
                        BackgroundColor="{DynamicResource PrimaryFill}"
                        StrokeThickness="0"
                        Padding="16,0"
                        MinimumHeightRequest="54"
                        SemanticProperties.Description="{Binding CallEmergencyText}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallEmergencyCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <ui:MaterialIconView IconName="Phone" IconSize="20" IconColor="White" VerticalOptions="Center" />
                            <Label
                                Text="{Binding CallEmergencyText}"
                                Style="{StaticResource EmphasisBodyStyle}"
                                FontFamily="{StaticResource SemiBoldFontFamily}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <BoxView
                        IsVisible="{Binding HasHotline}"
                        Style="{StaticResource SettingRowDividerStyle}"
                        Margin="0,2" />
                    <Grid
                        IsVisible="{Binding HasHotline}"
                        ColumnDefinitions="40,*,Auto"
                        ColumnSpacing="10"
                        MinimumHeightRequest="52"
                        SemanticProperties.Description="{Binding CallHotlineText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallHotlineCommand}" />
                        </Grid.GestureRecognizers>
                        <Border
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <ui:MaterialIconView IconName="SupportAgent" IconSize="20" IconColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding HotlineName}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" />
                            <Label Text="{Binding HotlineNumber}" Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                        <ui:MaterialIconView
                            Grid.Column="2"
                            IconName="Phone"
                            IconSize="18"
                            VerticalOptions="Center"
                            IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding SafetyPlanTitle}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" Padding="14,4">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Padding="0,4">
                            <Border WidthRequest="24" HeightRequest="24" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{Binding SafetyPlanStepNumber1}" Style="{StaticResource CaptionStyle}" TextColor="{DynamicResource Primary}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding SafetyPlanStep1}" Style="{StaticResource BodyStyle}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Padding="0,4">
                            <Border WidthRequest="24" HeightRequest="24" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{Binding SafetyPlanStepNumber2}" Style="{StaticResource CaptionStyle}" TextColor="{DynamicResource Primary}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding SafetyPlanStep2}" Style="{StaticResource BodyStyle}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Padding="0,4">
                            <Border WidthRequest="24" HeightRequest="24" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{Binding SafetyPlanStepNumber3}" Style="{StaticResource CaptionStyle}" TextColor="{DynamicResource Primary}" FontFamily="{StaticResource SemiBoldFontFamily}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding SafetyPlanStep3}" Style="{StaticResource BodyStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding OtherActionsTitle}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" Margin="4,0" />
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" Padding="12,4">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" MinimumHeightRequest="58" SemanticProperties.Description="{Binding SafetyPlanLinkTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSafetyPlanCommand}" /></Grid.GestureRecognizers>
                            <Border WidthRequest="36" HeightRequest="36" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <ui:MaterialIconView IconName="Checklist" IconSize="20" IconColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SafetyPlanLinkTitle}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" />
                                <Label Text="{Binding SafetyPlanLinkSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" MinimumHeightRequest="58" SemanticProperties.Description="{Binding OpenHelplineText}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenHelplineCommand}" /></Grid.GestureRecognizers>
                            <Border WidthRequest="36" HeightRequest="36" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <ui:MaterialIconView IconName="Public" IconSize="20" IconColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding OpenHelplineText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" />
                                <Label Text="{Binding OpenHelplineSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" MinimumHeightRequest="58" SemanticProperties.Description="{Binding FlashbackTitle}">
                            <Grid.Behaviors><behaviors:PressFeedbackBehavior /></Grid.Behaviors>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenFlashbackCommand}" /></Grid.GestureRecognizers>
                            <Border WidthRequest="36" HeightRequest="36" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <ui:MaterialIconView IconName="MyLocation" IconSize="20" IconColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FlashbackTitle}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" />
                                <Label Text="{Binding FlashbackSubtitle}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
