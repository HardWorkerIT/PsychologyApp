<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Conversation.ChatPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Conversation"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:tension="clr-namespace:PsychologyApp.Presentation.Widgets.TensionSlider"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <!-- A ready answer: a soft tinted chip, as the chips elsewhere in the app; four outlined blue frames were the loudest thing
             under the conversation. The base sits in the style, so the practice chip's fill in a trigger is not overridden. -->
        <Style x:Key="ChatQuickReplyStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: the companion (shared with the dialogue inside a practice) -->
        <avatar:CompanionHeaderView
            Grid.Row="0"
            Title="{Binding Title}"
            Status="{Binding StatusText}"
            ProfileText="{Binding OpenProfileText}"
            BackCommand="{Binding BackCommand}"
            ProfileCommand="{Binding OpenProfileCommand}" />

        <!-- Conversation -->
        <CollectionView
            x:Name="MessageList"
            Grid.Row="1"
            Margin="20,0"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            Scrolled="OnMessageListScrolled"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatBubble">
                    <VerticalStackLayout Margin="{Binding OuterMargin}" Spacing="8" BindingContextChanged="OnBubbleContextChanged">
                        <!-- The day as a quiet caption, like the dates elsewhere in the app; a grey pill stood out of the palette. -->
                        <Label
                            IsVisible="{Binding HasDate}"
                            Text="{Binding DateText}"
                            Style="{StaticResource CaptionStyle}"
                            HorizontalOptions="Center"
                            Margin="0,10,0,4" />

                        <Border
                            HorizontalOptions="{Binding Alignment}"
                            MaximumWidthRequest="300"
                            Padding="14,9,14,6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18,18,4,18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                    <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Text="{Binding TimeText}"
                                    Style="{StaticResource CaptionStyle}"
                                    FontSize="12"
                                    HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="#CCFFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ui:TypingBubbleView IsVisible="{Binding IsTyping}" IsRunning="{Binding IsTyping}" />
            </CollectionView.Footer>
        </CollectionView>

        <ui:ProgressBarView
            Grid.Row="1"
            IsLoading="{Binding IsLoadingOlderMessages}"
            IsVisible="{Binding IsLoadingOlderMessages}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,8,0,0"
            ProgressText="{Binding LoadingText}"
            SemanticProperties.Description="{Binding LoadingText}" />

        <ui:RetryView
            Grid.Row="1"
            IsVisible="{Binding IsOlderMessagesLoadFailed}"
            FailedText="{Binding OlderMessagesLoadFailedText}"
            RetryText="{Binding RetryOlderMessagesText}"
            RetryCommand="{Binding LoadOlderMessagesCommand}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="16,8" />

        <ui:RetryView
            Grid.Row="1"
            IsVisible="{Binding IsInitialLoadFailed}"
            FailedText="{Binding OlderMessagesLoadFailedText}"
            RetryText="{Binding RetryOlderMessagesText}"
            RetryCommand="{Binding RetryInitialLoadCommand}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="24" />

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Bubbles"
            VerticalOptions="Start"
            Margin="20,12,20,0"
            IsActive="{Binding IsLoading}" />

        <!-- Jump to the newest or the oldest message. Each appears only while there is somewhere to jump to. -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,14,14"
            Spacing="10">
            <Border
                x:Name="ScrollToTopButton"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToOldestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToTopTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowUp}"
                    FontSize="22"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Border
                x:Name="ScrollToBottomButton"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToNewestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToBottomTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowDown}"
                    FontSize="22"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Suggestions and the input bar -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">

            <!-- The tension question is a card of its own on the soft backdrop. -->
            <Border
                IsVisible="{Binding ShowTensionPicker}"
                Margin="20,8,20,0"
                Padding="0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <tension:TensionSliderView
                    x:Name="TensionPicker"
                    ReferenceValue="{Binding RatingReference}"
                    Chosen="OnTensionChosen" />
            </Border>

            <!-- Give the conversation and composer the space while the keyboard is open; one tap restores the choices. -->
            <Border
                IsVisible="{Binding ShowReplyOptionsToggle}"
                Margin="20,4,20,0"
                Padding="12,5"
                MinimumHeightRequest="44"
                HorizontalOptions="Start"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                SemanticProperties.Description="{Binding ReplyOptionsText}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReplyOptionsTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="4">
                    <Label
                        Text="{Binding ReplyOptionsText}"
                        FontSize="13"
                        FontFamily="{StaticResource MediumFontFamily}"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        VerticalOptions="Center" />
                    <Label
                        Text="{mi:Material Icon=KeyboardArrowUp}"
                        FontSize="18"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <ScrollView
                IsVisible="{Binding ShowQuickReplies}"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Margin="0,8,0,0"
                Padding="20,0">
                <HorizontalStackLayout
                    VerticalOptions="Center"
                    BindableLayout.ItemsSource="{Binding QuickReplies}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickReplyItem">
                            <Border
                                Margin="0,0,8,0"
                                BindingContextChanged="OnChipContextChanged"
                                MaximumWidthRequest="260"
                                Style="{StaticResource ChatQuickReplyStyle}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsPractice}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Reply}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Label}"
                                    FontSize="14"
                                    FontFamily="{StaticResource MediumFontFamily}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                                    MaxLines="2"
                                    LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPractice}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                            <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <ui:ChatInputBar
                x:Name="InputBar"
                IsEnabled="{Binding HasLoaded}"
                Margin="20,8,20,12"
                Text="{Binding DraftText, Mode=TwoWay}"
                Placeholder="{Binding Placeholder}"
                SendCommand="{Binding SendCommand}"
                CanSend="{Binding CanSend}"
                SendDescription="{Binding SendText}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
