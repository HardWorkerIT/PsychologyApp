<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ReadArticles.ForYou.ForYouPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:card="clr-namespace:PsychologyApp.Presentation.Widgets.LibraryCard"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ReadArticles.ForYou"
             x:DataType="vm:ForYouViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <!-- Opened over the tabs: the same back arrow and title as every other pushed page, instead of the system bar. -->
    <Grid RowDefinitions="Auto,*">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            Margin="20,0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding HasLoaded}"
                ItemsSource="{Binding Saved}"
                Margin="{StaticResource LayoutTabPageMarginThickness}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource ListItemSpacing}" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" Padding="0,20,0,0">
                        <VerticalStackLayout IsVisible="{Binding HasPicks}" BindableLayout.ItemsSource="{Binding Picks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="card:LibraryCardItem">
                                    <card:LibraryCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding SavedTitle}"
                               IsVisible="{Binding HasSaved}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="4,12,4,0" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="card:LibraryCardItem">
                        <card:LibraryCardView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <!-- Nothing yet: a short explanation and a few ways in, without making the empty state a separate screen. -->
                    <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}"
                                         IsVisible="{Binding IsEmpty}"
                                         Padding="0,8,0,0">
                        <Label Text="{Binding EmptyText}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                        <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" BindableLayout.ItemsSource="{Binding Starters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="card:LibraryCardItem">
                                    <card:LibraryCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <ui:ButtonView BodyText="{Binding TakeTestText}" TapCommand="{Binding TakeTestCommand}" Variant="Secondary" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
            <ui:SkeletonView
                Kind="Cards"
                Count="3"
                Margin="{StaticResource LayoutTabPageMarginThickness}"
                IsActive="{Binding IsLoading}" />
            <ui:RetryView
                IsVisible="{Binding IsLoadFailed}"
                FailedText="{Binding LoadFailedText}"
                RetryText="{Binding RetryText}"
                RetryCommand="{Binding ReloadCommand}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
