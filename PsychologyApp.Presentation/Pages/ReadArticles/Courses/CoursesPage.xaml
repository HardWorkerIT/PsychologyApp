<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Pages.ReadArticles.Courses.CoursesPage"
             xmlns:card="clr-namespace:PsychologyApp.Presentation.Widgets.LibraryCard"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ReadArticles.Courses"
             x:DataType="vm:CoursesViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <!-- Opened over the tabs: the same back arrow and title as every other pushed page, instead of the system bar. -->
    <Grid RowDefinitions="Auto,*">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            Margin="20,0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Sections}"
                        IsGrouped="True"
                        SelectionMode="None"
                        Margin="{StaticResource LayoutTabPageMarginThickness}"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource ListItemSpacing}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Label Text="{Binding LeadText}" Style="{StaticResource CaptionStyle}" Margin="4,0,4,4" />
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="card:LibraryCardItem">
                    <card:LibraryCardView />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.GroupFooterTemplate>
                <DataTemplate x:DataType="vm:CourseSectionItem">
                    <VerticalStackLayout IsVisible="False"
                                         BindingContextChanged="OnCourseAdFooterBindingContextChanged">
                        <ContentView />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.GroupFooterTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
