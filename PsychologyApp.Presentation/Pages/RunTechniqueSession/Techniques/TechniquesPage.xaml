<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTechniqueSession.Techniques.TechniquesPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTechniqueSession.Techniques"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:practiceUi="clr-namespace:PsychologyApp.Presentation.Widgets.TechniqueListCard"
             xmlns:today="clr-namespace:PsychologyApp.Presentation.Widgets.TodayPracticeRow"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:technique="clr-namespace:PsychologyApp.Presentation.Entities.Technique"
             x:DataType="vm:TechniquesViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding PageTitle}">

    <Grid
        VerticalOptions="FillAndExpand"
        HorizontalOptions="FillAndExpand">

        <CollectionView
            x:Name="TechniquesCollectionView"
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            ItemsSource="{Binding TechniquesItemsSource}"
            IsGrouped="{Binding IsTechniquesGrouped}"
            IsVisible="{Binding IsDone}"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never"
            HorizontalScrollBarVisibility="Never">
            <CollectionView.Behaviors>
                <behaviors:RevealOnAppearingBehavior RevealOnTabAppearOnly="True" />
            </CollectionView.Behaviors>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="technique:TechniqueGroup">
                    <Grid>
                        <Grid.Triggers>
                            <DataTrigger
                                Binding="{Binding HasTitle}"
                                TargetType="Grid"
                                Value="False">
                                <Setter Property="HeightRequest" Value="0" />
                                <Setter Property="MinimumHeightRequest" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid
                            IsVisible="{Binding HasTitle}"
                            ColumnDefinitions="*,Auto"
                            MinimumHeightRequest="44"
                            Padding="4,8,4,2"
                            SemanticProperties.Description="{Binding HeaderText}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Grid.GestureRecognizers>
                            <Label
                                Grid.Column="0"
                                Text="{Binding HeaderText}"
                                Style="{StaticResource CaptionStyle}"
                                FontFamily="{StaticResource SemiBoldFontFamily}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                VerticalOptions="Center" />
                            <!-- Two arrows, one shown at a time: the icon markup cannot be used inside a Setter (it crashed the page). -->
                            <Label
                                Grid.Column="1"
                                IsVisible="{Binding ShowsOpenArrow}"
                                Text="{mi:Material Icon=KeyboardArrowDown}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                IsVisible="{Binding ShowsClosedArrow}"
                                Text="{mi:Material Icon=KeyboardArrowRight}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource ListItemSpacing}" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0" Padding="0">
                    <VerticalStackLayout.Behaviors>
                        <behaviors:StaggerChildrenBehavior />
                    </VerticalStackLayout.Behaviors>

                    <Border
                        IsVisible="{Binding HasClinicalRiskBanner}"
                        Style="{StaticResource TodayBannerStyle}"
                        Margin="{StaticResource CardBottomMargin}">
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                            <behaviors:ListItemRevealBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCrisisHubCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding ClinicalRiskBanner}" Style="{StaticResource BodyStyle}" />
                    </Border>

                    <today:TodayPracticeRowView
                        CaptionText="{Binding TodayForYouLabel}"
                        IconName="{Binding TodayTechniqueItem.IconName}"
                        Title="{Binding TodayTechniqueItem.Title}"
                        Subtitle="{Binding TodayTechniqueItem.Subtitle}"
                        NudgeText="{Binding EngagementNudgeText}"
                        HideHint="{Binding HasClinicalRiskBanner}"
                        HasNudge="{Binding ShowEngagementNudge}"
                        ReasonText="{Binding TodayReasonText}"
                        MetaText="{Binding TherapyProgramBanner}"
                        HasMeta="{Binding HasTherapyProgramBanner}"
                        TapCommand="{Binding StartTodayPracticeCommand}">
                        <today:TodayPracticeRowView.Behaviors>
                            <behaviors:RevealOnAppearingBehavior />
                        </today:TodayPracticeRowView.Behaviors>
                    </today:TodayPracticeRowView>

                    <Border IsVisible="{Binding IsNextStepVisible}"
                            Style="{StaticResource TestFlatCardStyle}"
                            Margin="{StaticResource CardBottomMargin}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding NextStepTitle}" Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="{Binding NextStepSummaryText}" Style="{StaticResource CaptionStyle}" />
                                </VerticalStackLayout>
                                <ui:ButtonView Grid.Column="1"
                                               BodyText="{Binding NextStepPrimaryActionText}"
                                               TapCommand="{Binding StartNextStepCommand}"
                                               AccessibilityHint="{Binding NextStepPrimaryActionHint}"
                                               IsVisible="{Binding IsNextStepPrimaryActionVisible}"
                                               IsCompact="True" />
                            </Grid>
                            <FlexLayout BindableLayout.ItemsSource="{Binding SavedQuickActions}"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Start"
                                        AlignContent="Start"
                                        IsVisible="{Binding HasSavedNextStep}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavedNextStepQuickAction">
                                        <ui:ButtonView Margin="0,0,8,8"
                                                       FlexLayout.Shrink="0"
                                                       FlexLayout.AlignSelf="Start"
                                                       BodyText="{Binding Label}"
                                                       AccessibilityLabel="{Binding AccessibilityLabel}"
                                                       AccessibilityHint="{Binding AccessibilityHint}"
                                                       TapCommand="{Binding StartSavedNextStepCommand, Source={RelativeSource AncestorType={x:Type vm:TechniquesViewModel}}, x:DataType=vm:TechniquesViewModel}"
                                                       CommandParameter="{Binding .}"
                                                       Variant="Secondary"
                                                       IsCompact="True" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <ui:ButtonView BodyText="{Binding NextStepChoiceToggleText}"
                                           TapCommand="{Binding ToggleNextStepChooserCommand}"
                                           IsVisible="{Binding IsNextStepChoiceToggleVisible}"
                                           AccessibilityHint="{Binding NextStepToggleHint}"
                                           Variant="Secondary"
                                           IsCompact="True" />
                            <VerticalStackLayout IsVisible="{Binding IsNextStepChooserExpanded}" Spacing="8">
                                <Label Text="{Binding NextStepCapacityText}" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding NextStepLimitReachedText}"
                                       Style="{StaticResource CaptionStyle}"
                                       IsVisible="{Binding IsNextStepLimitMessageVisible}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <ui:ButtonView Grid.Row="0" Grid.Column="0"
                                                   BodyText="{Binding NextStepGroundingLabel}"
                                                   AccessibilityLabel="{Binding NextStepGroundingAccessibilityLabel}"
                                                   AccessibilityHint="{Binding NextStepSelectionHint}"
                                                   TapCommand="{Binding SelectNextStepGroundingCommand}"
                                                   Variant="{Binding NextStepGroundingVariant}"
                                                   IsCompact="True" />
                                    <ui:ButtonView Grid.Row="0" Grid.Column="1"
                                                   BodyText="{Binding NextStepThoughtLabel}"
                                                   AccessibilityLabel="{Binding NextStepThoughtAccessibilityLabel}"
                                                   AccessibilityHint="{Binding NextStepSelectionHint}"
                                                   TapCommand="{Binding SelectNextStepThoughtCommand}"
                                                   Variant="{Binding NextStepThoughtVariant}"
                                                   IsCompact="True" />
                                    <ui:ButtonView Grid.Row="1" Grid.Column="0"
                                                   BodyText="{Binding NextStepSmallStepLabel}"
                                                   AccessibilityLabel="{Binding NextStepSmallStepAccessibilityLabel}"
                                                   AccessibilityHint="{Binding NextStepSelectionHint}"
                                                   TapCommand="{Binding SelectNextStepSmallStepCommand}"
                                                   Variant="{Binding NextStepSmallStepVariant}"
                                                   IsCompact="True" />
                                    <ui:ButtonView Grid.Row="1" Grid.Column="1"
                                                   BodyText="{Binding NextStepMoodLabel}"
                                                   AccessibilityLabel="{Binding NextStepMoodAccessibilityLabel}"
                                                   AccessibilityHint="{Binding NextStepSelectionHint}"
                                                   TapCommand="{Binding SelectNextStepMoodCommand}"
                                                   Variant="{Binding NextStepMoodVariant}"
                                                   IsCompact="True" />
                                </Grid>
                                <ui:ButtonView BodyText="{Binding NextStepSaveActionText}"
                                               TapCommand="{Binding ToggleSavedNextStepCommand}"
                                               IsVisible="{Binding HasNextStepSelection}"
                                               IsEnabled="{Binding IsNextStepSaveActionEnabled}"
                                               AccessibilityHint="{Binding NextStepSaveActionHint}"
                                               Variant="Secondary"
                                               IsCompact="True" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <ui:SectionHeaderView
                        Margin="0"
                        TitleText="{Binding PracticeCatalogLabel}"
                        ActionText="{Binding CreateButtonText}"
                        ActionCommand="{Binding ConstructorTapped}" />
                    <HorizontalStackLayout HorizontalOptions="End" Margin="0,4,0,8"
                                           IsVisible="{Binding IsPracticeFinderVisible}">
                        <ui:ButtonView BodyText="{Binding PracticeFinderButtonText}"
                                      AccessibilityHint="{Binding PracticeFinderAccessibilityHint}"
                                      TapCommand="{Binding FindPracticeCommand}"
                                      Variant="Secondary"
                                      IsCompact="True" />
                    </HorizontalStackLayout>
                    <ContentView x:Name="PracticeAdHost"
                                 IsVisible="False"
                                 Margin="0,8" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- On Android the card is one native view (TechniqueCardNativeView): the XAML card made fast scrolling stutter. -->
            <CollectionView.ItemTemplate>
                <OnPlatform x:TypeArguments="DataTemplate">
                    <On Platform="Android">
                        <DataTemplate x:DataType="technique:TechniqueItem">
                            <practiceUi:TechniqueCardNativeView
                                Margin="4,4,4,4"
                                IsVisible="{Binding Active}"
                                SemanticProperties.Description="{Binding Title}"
                                Title="{Binding Title}"
                                Subtitle="{Binding Subtitle}"
                                MetaText="{Binding MetaText}"
                                IconName="{Binding IconName}"
                                Image="{Binding Image}"
                                Flavor="{Binding Flavor}"
                                TapCommand="{Binding TapCommand}">
                                <practiceUi:TechniqueCardNativeView.Behaviors>
                                    <behaviors:ListItemRevealBehavior />
                                </practiceUi:TechniqueCardNativeView.Behaviors>
                            </practiceUi:TechniqueCardNativeView>
                        </DataTemplate>
                    </On>
                    <On Platform="iOS, MacCatalyst">
                        <DataTemplate x:DataType="technique:TechniqueItem">
                            <practiceUi:TechniqueListCardView
                                Number="{Binding Number}"
                                Image="{Binding Image}"
                                IconName="{Binding IconName}"
                                MetaText="{Binding MetaText}"
                                Title="{Binding Title}"
                                Subtitle="{Binding Subtitle}"
                                Theme="{Binding Theme}"
                                Flavor="{Binding Flavor}"
                                Active="{Binding Active}"
                                TapCommand="{Binding TapCommand}">
                                <practiceUi:TechniqueListCardView.Behaviors>
                                    <behaviors:ListItemRevealBehavior />
                                </practiceUi:TechniqueListCardView.Behaviors>
                            </practiceUi:TechniqueListCardView>
                        </DataTemplate>
                    </On>
                </OnPlatform>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <ui:EmptyStateView
                    TitleText="{Binding PracticeEmptyTitle}"
                    BodyText="{Binding PracticeEmptyBody}"
                    IconName="SelfImprovement"
                    ActionText="{Binding CreateButtonText}"
                    ActionCommand="{Binding ConstructorTapped}" />
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="8">
                    <Grid
                        HeightRequest="{Binding LoadMoreFooterHeight}"
                        MinimumHeightRequest="{Binding LoadMoreFooterHeight}"
                        IsClippedToBounds="True">
                    <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
                        IsVisible="{Binding IsLoadingMoreCustomTechniques}"
                        IsLoading="{Binding IsLoadingMoreCustomTechniques}"
                        ProgressText="{Binding LoadingMoreText}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Margin="0,8" />
                    </Grid>
                    <!-- Room under the last card for the round chat button. -->
                    <BoxView HeightRequest="72" Color="Transparent" />
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <ui:SkeletonView
            Kind="Cards"
            VerticalOptions="Start"
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            IsActive="{Binding IsLoadingOverlayVisible}" />

        <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
            x:Name="LoadingProgress"
            VerticalOptions="End"
            Margin="0,0,0,24"
            HorizontalOptions="Center"
            IsVisible="{Binding IsSlowLoadingVisible}"
            IsLoading="{Binding IsSlowLoadingVisible}"
            ProgressText="{Binding LoadingText}"
            CancelCommand="{Binding Cancel}" />

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding FailedText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding Reload}" />

    </Grid>
</ContentPage>
