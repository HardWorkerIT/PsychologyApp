<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-maccatalyst27.2;net11.0-ios27.2;net11.0-android37.0</TargetFrameworks>
		<!-- Linux (the android-smoke runner) has no iOS or Mac Catalyst workloads, and a restore of those target frameworks fails there. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net11.0-android37.0</TargetFrameworks>
		<!-- CI cannot build Apple targets on Windows; those targets are built on macOS in a separate job. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) And '$(CI)' == 'true'">net11.0-android37.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PsychologyApp.Presentation</RootNamespace>
		<UseMaui>true</UseMaui>
		<UseMaterial3 Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseMaterial3>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Compile bindings that set Source ({x:Reference Root}, TemplatedParent) too; they're most of the app's bindings. -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!-- Generate C# for XAML in every configuration. The default inflates XAML by reflection at runtime in
		     Debug, which made every first page/tab open stall the UI thread for seconds (skipped frames on device). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<!-- ViewModels are DI-only; nullable init warnings are false positives in partial MAUI types. -->
		<NoWarn>$(NoWarn);XA4304;CA1416;CS0618</NoWarn>

		<!-- Display name -->
		<ApplicationTitle>Psychology App</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.subconscious.psychologyapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.013</ApplicationDisplayVersion>
		<ApplicationVersion>2013</ApplicationVersion>
		<!-- Keep NuGet's project metadata stable across MAUI target frameworks in Visual Studio. -->
		<PackageVersion>2.012</PackageVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Debug'">
	  <!-- Visual Studio F5 must never target the installed production app or its private data. -->
	  <ApplicationId Condition="'$(ApplicationId)' == 'com.subconscious.psychologyapp'">com.subconscious.psychologyapp.dev</ApplicationId>
	  <ApplicationTitle Condition="'$(ApplicationTitle)' == 'Psychology App'">Psychology DEV</ApplicationTitle>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <IsPublishable>False</IsPublishable>
	  <Debugger>Xamarin</Debugger>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>portable</DebugType>
	  <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	  <!-- Disable fast deployment: avoids XA0129 push failures to .__override__ on device. -->
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <!-- Debug: arm64 for physical devices + x64 for Windows emulator; avoids all 4 ABIs (XAWAS7024). scripts/android-run.sh
	       passes -p:AndroidDevRid with the connected device's ABI, so a run builds one ABI instead of two. -->
	  <RuntimeIdentifiers Condition="'$(AndroidDevRid)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
	  <RuntimeIdentifiers Condition="'$(AndroidDevRid)' != ''">$(AndroidDevRid)</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Release Android: single source of truth for build, run, and publish (no duplicate TFM|Platform overrides). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <!-- Play Console: aab. Sideload on phone: -p:AndroidPackageFormat=apk -p:RuntimeIdentifier=android-arm64 -->
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <!-- Keep partial trimming: the app, Dapper and the explicitly rooted libraries below stay whole. -->
	  <PublishTrimmed>True</PublishTrimmed>
	  <TrimMode>partial</TrimMode>
	  <!-- Compile every Android app assembly ahead of time for Release; CoreCLR remains available for dynamic code. -->
	  <MauiEnableFullReadyToRun>true</MauiEnableFullReadyToRun>
	  <DebugSymbols>False</DebugSymbols>
	  <AndroidIncludeDebugSymbols>False</AndroidIncludeDebugSymbols>
	  <!-- Link framework assemblies only; R8 and ProguardConfiguration shrink Java code. -->
	  <AndroidLinkTool>r8</AndroidLinkTool>
	  <AndroidLinkMode>SdkOnly</AndroidLinkMode>
	  <!-- Phones only. An emulator package (to measure Release on an x86_64 emulator, where arm64 runs translated and slow):
	       -p:AndroidReleaseRid=android-x64. Not -p:RuntimeIdentifiers: a global RID flows into the class libraries and breaks their build. -->
	  <RuntimeIdentifiers Condition="'$(AndroidReleaseRid)' == ''">android-arm64</RuntimeIdentifiers>
	  <RuntimeIdentifiers Condition="'$(AndroidReleaseRid)' != ''">$(AndroidReleaseRid)</RuntimeIdentifiers>
	  <!-- Release signing: paths/passwords in AndroidSigning.local.props (gitignored) or env vars. -->
	  <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
	  <AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' != ''">$(AndroidSigningKeyAlias)</AndroidSigningKeyAlias>
	  <AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' != ''">$(AndroidSigningStorePass)</AndroidSigningStorePass>
	  <AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' != ''">$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-maccatalyst27.2|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-ios27.2|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-windows10.0.19041.0|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-maccatalyst27.2|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-ios27.2|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-windows10.0.19041.0|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProguardConfiguration Include="Platforms\Android\proguard-rules.pro" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\logo.jpeg"
		          ForegroundFile="Resources\AppIcon\logo_foreground.png"
		          Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\logo.jpeg" Color="#FFFFFF" BaseSize="512,512" />

		<!-- Images -->
		<MauiImage Include="Resources\AppIcon\logo.jpeg" Link="Resources\Images\onboarding_app_logo.jpeg" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Renderers\**" />
	  <EmbeddedResource Remove="Renderers\**" />
	  <MauiCss Remove="Renderers\**" />
	  <MauiXaml Remove="Renderers\**" />
	  <None Remove="Renderers\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Raw\Psyhosomatic.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Material" Version="5.0.0" />
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Material.Outlined" Version="5.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
		<!-- Android plays music with the platform MediaPlayer (Platforms/Android/AndroidAudioPlaybackService.cs);
		     MediaElement and its ExoPlayer are only shipped to iOS and Mac. -->
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="12.0.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
		<PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />

		<TrimmerRootAssembly Include="Microsoft.Maui" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Controls" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Controls.Xaml" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Graphics" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Essentials" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui.Core" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui.MediaElement" RootMode="All" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
		<TrimmerRootAssembly Include="MauiIcons.Core" RootMode="All" />
		<TrimmerRootAssembly Include="MauiIcons.Material" RootMode="All" />
		<TrimmerRootAssembly Include="MauiIcons.Material.Outlined" RootMode="All" />
		<TrimmerRootAssembly Include="MvvmHelpers" RootMode="All" />
		<TrimmerRootAssembly Include="Dapper" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Data.Sqlite" RootMode="All" />
		<TrimmerRootAssembly Include="System.Text.Json" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Presentation" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Presentation.Core" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Bootstrap" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Application" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Infrastructure" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Domain" RootMode="All" />
	
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PsychologyApp.Application\PsychologyApp.Application.csproj" />
	  <ProjectReference Include="..\PsychologyApp.Bootstrap\PsychologyApp.Bootstrap.csproj" />
	  <ProjectReference Include="..\PsychologyApp.Presentation.Core\PsychologyApp.Presentation.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\PsychologyApp.VkAds.Android\PsychologyApp.VkAds.Android.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="PsychologyApp.Presentation.Tests" />
	</ItemGroup>

	<Import Project="AndroidSigning.local.props" Condition="Exists('AndroidSigning.local.props')" />

	<!-- -p:PerfTrace=true keeps the PerfTrace timings in a Release build, so slow screens can be attributed where they are measured. -->
	<PropertyGroup Condition="'$(PerfTrace)' == 'true'">
		<DefineConstants>$(DefineConstants);PERFTRACE</DefineConstants>
	</PropertyGroup>

</Project>
